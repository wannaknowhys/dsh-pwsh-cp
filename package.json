  "description": "Pin every pwsh tool call to a UTF-8 console code page and Python UTF-8 mode",
  "type": "module",
  "license": "MIT",
  "author": "wannaknowhys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannaknowhys/dsh-pwsh-cp.git"
  },
  "homepage": "https://github.com/wannaknowhys/dsh-pwsh-cp#readme",
  "bugs": {
    "url": "https://github.com/wannaknowhys/dsh-pwsh-cp/issues"
  },
  "main": "lib/index.js",
  "exports": {
